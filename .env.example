# ==============================================================================
# Civic Air Quality Briefing Studio - Environment Variables Example
# Duplicate this file to `.env.local` for local development or `.env.production`
# for production deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Generative AI Configuration (Google AI Studio or OpenRouter)
# ------------------------------------------------------------------------------
# Supports either:
# 1. Official Google AI Studio API Key (starts with AIzaSy...):
#    https://aistudio.google.com/app/apikey
# 2. OpenRouter API Key (starts with sk-or-v1-...):
#    https://openrouter.ai/keys
#
# If left empty, the application seamlessly uses the built-in Deterministic
# Civic Intelligence Rule Engine without throwing errors.
GEMINI_API_KEY=your_api_key_here
# Alternative OpenRouter key variable:
OPENROUTER_API_KEY=

# Default model used for civic intelligence synthesis
# For Google AI Studio: gemini-1.5-flash (recommended), gemini-2.0-flash, gemini-1.5-pro
# For OpenRouter: google/gemini-2.0-flash-exp:free, google/gemini-flash-1.5
NEXT_PUBLIC_GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Application Environment & URLs
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Civic Air Quality Briefing Studio"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# OpenAQ Real-Time Global Telemetry API (Optional)
# ------------------------------------------------------------------------------
# Base URL for public air monitoring data queries
OPENAQ_API_BASE_URL=https://api.openaq.org/v2

# ------------------------------------------------------------------------------
# Telemetry Audit Configuration
# ------------------------------------------------------------------------------
# Threshold in consecutive readings to trigger a sensor freeze flag (default: 4)
SENSOR_FREEZE_THRESHOLD=4
# Telemetry gap threshold in hours to trigger a data dropout warning (default: 2)
TELEMETRY_GAP_HOURS_THRESHOLD=2
