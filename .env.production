# ==============================================================================
# Civic Air Quality Briefing Studio - Production Environment (.env.production)
# Used automatically by Next.js in production builds (`next build`, `next start`).
# On Vercel, sensitive secrets (like GEMINI_API_KEY) should be set directly in
# the Vercel Project Settings > Environment Variables dashboard.
# ==============================================================================

# Production Gemini API Key
# (Leave empty here if setting via Vercel Dashboard / deployment secrets)
GEMINI_API_KEY=

# Default Gemini model
NEXT_PUBLIC_GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Civic Air Quality Briefing Studio"
NEXT_PUBLIC_APP_URL=https://civic-air-quality-briefing-studio.vercel.app

# OpenAQ API endpoint
OPENAQ_API_BASE_URL=https://api.openaq.org/v2

# Telemetry audit tuning
SENSOR_FREEZE_THRESHOLD=4
TELEMETRY_GAP_HOURS_THRESHOLD=2
